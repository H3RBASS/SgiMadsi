@page "/caja"
@layout Navbar

<PageTitle>Caja</PageTitle>

<div class="min-h-screen w-full bg-gray-50 text-gray-800">
    <main class="flex-1 p-4 lg:p-6">
        <!-- Encabezado: Buscador + Botón -->
        <div class="bg-white rounded-xl shadow-sm px-4 py-6 sm:px-6 lg:p-4 mb-6">
            <div class="flex flex-col md:flex-row gap-4 items-center">
                <header>
                    <h1 class="text-xl lg:text-2xl font-bold text-gray-800">Caja</h1>
                </header>
                <form class="flex flex-row w-full gap-4">
                    <input
                        @bind="_busqueda" 
                        @bind:event="oninput"
                        @bind:after="@BuscarProductos" 
                        type="text" 
                        placeholder="Buscar producto..." 
                        class="w-full border border-gray-500 rounded-lg px-4 py-2 text-sm 
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </form>
                <div class="flex flex-row sm:flex-row items-center justify-center gap-3 max-w-md sm:max-w-none">
                <!-- Botón Eliminar -->
                    <button 
                    @onclick="LimpiarBusqueda"
                    class="
                        group
                        flex items-center justify-center gap-2
                        w-full sm:w-auto px-5 py-3
                        bg-red-600 text-white text-sm font-medium
                        rounded-lg shadow-sm hover:shadow-md
                        transition-all duration-200 ease-in-out
                        hover:bg-red-700 hover:scale-105
                        focus:outline-none
                        active:scale-95
                        cursor-pointer
                    ">
                        <span class="group-hover:scale-110 transition-transform duration-300">Limpiar</span>
                        <svg xmlns="http://www.w3.org/2000/svg" 
                        class="w-5 h-5 group-hover:rotate-12 transition-transform duration-300" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round"
                        aria-hidden="true"
                        >
                        <path d="M10 11v6"/>
                        <path d="M14 11v6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                        <path d="M3 6h18"/>
                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </button>

                    <!-- Botón Venta -->
                    <button class="
                        group
                        flex items-center justify-center gap-2
                        w-full sm:w-auto px-5 py-3
                        bg-blue-600 text-white text-sm font-medium
                        rounded-lg shadow-sm hover:shadow-md
                        transition-all duration-200 ease-in-out
                        hover:bg-blue-700 hover:scale-105
                        focus:outline-none
                        active:scale-95
                        cursor-pointer
                    ">
                        <span class="group-hover:scale-110 transition-transform duration-300">Venta</span>
                        <svg xmlns="http://www.w3.org/2000/svg" 
                        class="w-5 h-5 group-hover:-rotate-12 transition-transform duration-300" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round"
                        aria-hidden="true"
                        >
                        <circle cx="8" cy="21" r="1"/>
                        <circle cx="19" cy="21" r="1"/>
                        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Cuerpo: dos columnas con scroll -->
<!-- Contenedor padre: ocupa todo el alto restante (ajusta según tu layout) -->
<div class="h-[calc(100vh-150px)] p-4"> <!-- Si no usas flex, usa h-[calc(100vh-200px)] o similar -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 h-full">
        
        <!-- Columna izquierda: Categorías -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
            <div class="bg-gray-100 px-4 py-3 font-medium text-gray-700 border-b flex-none">
                Productos
            </div>
            
            <!-- Grid de categorías responsivo y scrolleable -->
            <div class="flex-1 overflow-y-auto min-h-0 p-1">
                <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-1 xl:grid-cols-1 gap-1 auto-rows-min">
                    @foreach (var producto in _productosFiltrados.OrderBy(p => p.Nombre))
                    {
                        <button 
                        @onclick="() => obtenerProductoVenta(producto.Nombre)"
                        class="flex items-center justify-center w-full py-3 px-2 cursor-pointer 
                                       text-gray-700 hover:bg-gray-800 hover:text-white 
                                       transition-colors duration-150 focus:outline-none rounded-lg">
                            <span class="text-md font-medium text-center break-words">@($"{producto.Subcategoria} {producto.Nombre} - ({producto.PrecioVenta} Bs.)")</span>
                        </button>
                    }
                    @if (!_productosFiltrados.Any())
                    {
                        <div class="col-span-full px-4 py-8 text-center text-gray-400">No hay categorías</div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna derecha: Venta Actual -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
            <div class="bg-gray-100 px-4 py-3 font-medium text-gray-700 border-b flex-none">
                🛒 Venta Actual
            </div>
            <div class="flex-1 overflow-y-auto p-4 min-h-0">
                <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-1 xl:grid-cols-1 gap-1 auto-rows-min">
                    @foreach (var producto in _productosSeleccionados)
                    {
                        <button 
                        class="flex items-center justify-center w-full py-3 px-2 cursor-pointer 
                                text-gray-700 hover:bg-red-800 hover:text-white 
                                transition-colors duration-150 focus:outline-none rounded-lg">   
                            <p>@producto.Nombre</p> 
                            <br />
                            <p>@producto.PrecioVenta Bs.</p>
                        </button>
                    }
                    @if(!_productosSeleccionados.Any())
                    {
                        <p>No hay productos seleccionados</p>
                        <p class="text-sm mt-1">Haz clic en un producto para agregar</p>
                    }
                </div>
                <!-- Aquí irían los productos agregados -->
            </div>
        </div>

    </div>
</div>
    </main>
</div>
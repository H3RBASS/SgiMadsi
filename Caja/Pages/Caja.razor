@page "/"
@layout Navbar

<PageTitle>Caja</PageTitle>

<div class="min-h-screen w-full bg-gray-50 text-gray-800">
    <main class="flex-1 p-4 lg:p-6">
        @* Alerta Venta *@
        @* <div class="flex flex-col absolute top-30 right-25 sm:right-4 lg:right-18 lg:top-4/5 gap-2 w-46 text-xs z-50">
        <div class="succsess-alert cursor-default flex items-center justify-between w-full sm:w-55 h-12 sm:h-14 rounded-lg bg-gray-800 px-2.5">
            <div class="flex gap-2">
            <div class="text-[#2b9875] bg-white/5 backdrop-blur-xl p-1 rounded-lg">
                <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6"
                >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m4.5 12.75 6 6 9-13.5"
                ></path>
                </svg>
            </div>
                <div class="flex items-center justify-center">
                    <p class="text-white">Venta guardada correctamente</p>
                </div>
            </div>
            <button class="text-gray-600 hover:bg-white/5 p-1 rounded-md transition-colors ease-linear">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18 18 6M6 6l12 12"
                ></path>
            </svg>
            </button>
        </div>
        </div> *@

        <!-- Encabezado: Buscador + Botón -->
        <div class="bg-white rounded-xl shadow-sm px-4 py-6 sm:px-6 lg:p-4 mb-6">
            <div class="flex flex-col md:flex-row gap-4 items-center">
                <header>
                    <h1 class="text-xl lg:text-2xl font-bold text-gray-800">Caja</h1>
                </header>
                <form class="flex flex-row w-full gap">
                    <input
                        @bind="_busqueda" 
                        @bind:event="oninput"
                        @bind:after="@BuscarProductos" 
                        type="text" 
                        placeholder="Buscar producto..." 
                        class="w-full border border-gray-500 rounded-lg px-4 py-2 text-sm 
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </form>
                <div class="flex flex-row sm:flex-row items-center justify-center gap-3 max-w-md sm:max-w-none">
                <!-- Botón Eliminar -->
                    <button 
                    @onclick="LimpiarBusqueda"
                    class="
                        group
                        flex items-center justify-center gap-2
                        w-full sm:w-auto px-5 py-3
                        bg-red-600 text-white text-sm font-medium
                        rounded-lg shadow-sm hover:shadow-md
                        transition-all duration-200 ease-in-out
                        hover:bg-red-700 hover:scale-105
                        focus:outline-none
                        active:scale-95
                        cursor-pointer
                    ">
                        <span class="group-hover:scale-110 transition-transform duration-300">Limpiar</span>
                        <svg xmlns="http://www.w3.org/2000/svg" 
                        class="w-5 h-5 group-hover:rotate-12 transition-transform duration-300" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round"
                        aria-hidden="true"
                        >
                        <path d="M10 11v6"/>
                        <path d="M14 11v6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                        <path d="M3 6h18"/>
                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </button>
                <!-- Botón Arqueo -->
                    <button 
                    @onclick="() => MostrarModalArqueo = true"
                    class="
                        group
                        flex items-center justify-center gap-2
                        w-full sm:w-auto px-5 py-3
                        bg-blue-600 text-white text-sm font-medium
                        rounded-lg shadow-sm hover:shadow-md
                        transition-all duration-200 ease-in-out
                        hover:bg-blue-700 hover:scale-105
                        focus:outline-none
                        active:scale-95
                        cursor-pointer
                    ">
                        <span class="group-hover:scale-110 transition-transform duration-300">Arqueo</span>

                        <svg xmlns="http://www.w3.org/2000/svg" 
                        class="w-5 h-5 group-hover:rotate-12 transition-transform duration-300 size-6" 
                        fill="none" 
                        viewBox="0 0 24 24" 
                        stroke-width="1.5" 
                        stroke="currentColor" 
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
                        </svg>

                    </button>

                    <!-- Botón Venta -->
                    <button 
                    @onclick="CarritoEstado"
                    class="
                        group
                        flex items-center justify-center gap-2
                        w-full sm:w-auto px-5 py-3
                        bg-blue-600 text-white text-sm font-medium
                        rounded-lg shadow-sm hover:shadow-md
                        transition-all duration-200 ease-in-out
                        hover:bg-blue-700 hover:scale-105
                        focus:outline-none
                        active:scale-95
                        cursor-pointer
                    ">
                        <span class="group-hover:scale-110 transition-transform duration-300">Venta</span>
                        <svg xmlns="http://www.w3.org/2000/svg" 
                        class="w-5 h-5 group-hover:-rotate-12 transition-transform duration-300" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round"
                        aria-hidden="true"
                        >
                        <circle cx="8" cy="21" r="1"/>
                        <circle cx="19" cy="21" r="1"/>
                        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        @if (MostrarModalVenta)
        {
            <div class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
                <div class="w-full max-w-2xl max-h-[90vh] bg-white rounded-xl shadow-xl flex flex-col overflow-hidden">

                    <EditForm Model="_checkout" OnValidSubmit="RegistrarVenta" class="flex flex-col min-h-0">
                        <DataAnnotationsValidator />

                        <!-- Header -->
                        <div class="shrink-0 px-5 py-4 sm:px-6 border-b border-gray-200">
                            <h3 class="text-xl sm:text-2xl font-bold text-gray-800 text-center">
                                CHECKOUT
                            </h3>
                        </div>

                        <!-- Productos -->
                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <div class="px-3 py-4 sm:px-6">
                                <div class="w-full rounded-lg border border-gray-200 overflow-hidden">
                                    <table class="w-full table-fixed border-collapse">

                                        <colgroup>
                                            <col class="w-[55%]" />
                                            <col class="w-[20%]" />
                                            <col class="w-[25%]" />
                                        </colgroup>

                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-3 sm:px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                                    Producto
                                                </th>
                                                <th class="px-2 sm:px-3 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                                    Cant.
                                                </th>
                                                <th class="px-2 sm:px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                                    Subtotal
                                                </th>
                                            </tr>
                                        </thead>

                                        <tbody class="divide-y divide-gray-200 bg-white">
                                            @foreach (var item in _carrito)
                                            {
                                                <tr>
                                                    <td class="px-3 sm:px-4 py-3 align-middle">
                                                        <div class="text-sm font-medium text-gray-900 wrap-break-word leading-5">
                                                            @($"{item.Subcategoria} {item.Nombre}")
                                                        </div>
                                                    </td>

                                                    <td class="px-2 sm:px-3 py-3 text-center align-middle text-sm font-medium text-gray-900">
                                                        @($"x{item.Cantidad}")
                                                    </td>

                                                    <td class="px-2 sm:px-3 py-3 text-right align-middle text-sm font-medium text-gray-900 whitespace-nowrap">
                                                        @($"{item.Cantidad * item.PrecioVenta} Bs")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Resumen -->
                        <div class="shrink-0 px-4 py-4 sm:px-6 border-t border-gray-200 bg-gray-50">

                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                <span class="text-sm font-medium text-gray-900">
                                    Método de Pago:
                                </span>

                                <InputRadioGroup @bind-Value="_checkout.MetodoPago">
                                    <div class="flex flex-wrap gap-4">
                                        <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                                            <InputRadio Value="@("Efectivo")" />
                                            <span>Efectivo</span>
                                        </label>

                                        <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
                                            <InputRadio Value="@("QR")" />
                                            <span>QR</span>
                                        </label>
 
                                    </div>
                                </InputRadioGroup>
                            </div>
                            <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-200">
                                <span>Descuento:</span>
                                @* <span>@(_checkout.Descuento) Bs.</span> *@
                                <InputNumber @bind-Value="_checkout.Descuento"
                                            min="0"
                                            step="0.5"
                                            default="0"
                                            class="w-26 text-center border border-gray-300 rounded-lg py-1 text-sm focus:outline-none 
                                                    focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                            </div>
                            <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-200">
                                <span>Subtotal:</span>

                                <span class="text-base sm:text-lg font-bold text-gray-400 whitespace-nowrap">
                                    @($"{_carrito.Sum(x => x.PrecioVenta * x.Cantidad)} Bs.")
                                </span>
                            </div>

                            <div class="mt-3 pt-3 border-t border-gray-200 flex items-center justify-between gap-3">
                                <span class="text-sm font-medium text-gray-900">
                                    Total:
                                </span>

                                <span class="text-base sm:text-lg font-bold text-gray-800 whitespace-nowrap">
                                    @($"{_carrito.Sum(x => x.PrecioVenta * x.Cantidad) - _checkout.Descuento} Bs.")
                                </span>
                            </div>

                        </div>

                        <!-- Botones -->
                        <div class="shrink-0 px-4 py-4 sm:px-6 border-t border-gray-200 bg-white">
                            <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 sm:justify-center">

                                <button type="button"
                                        @onclick="() => MostrarModalVenta = false"
                                        class="w-full cursor-pointer sm:w-auto min-h-11 px-5 py-2.5 rounded-lg bg-gray-100 text-gray-700 font-medium inline-flex items-center justify-center gap-2 transition hover:bg-gray-200 active:scale-[0.98]">

                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>

                                    <span>Cancelar</span>
                                </button>

                                @* Condicional para el estado de Boton Guardar *@
                            @if(_procesando)
                            {
                                <button
                                    disabled
                                    class="w-full sm:w-auto cursor-pointer px-6 py-2.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 font-medium shadow-sm flex items-center justify-center gap-2">
                                    <svg
                                        class="h-5 w-5 animate-spin"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24">

                                        <circle
                                            class="opacity-25"
                                            cx="12"
                                            cy="12"
                                            r="10"
                                            stroke="currentColor"
                                            stroke-width="4"/>

                                        <path
                                            class="opacity-75"
                                            fill="currentColor"
                                            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
                                    </svg>
                                    Guardando...
                                </button>
                            }
                            else
                            {
                                <!-- Botón Guardar -->
                                <button class="w-full sm:w-auto cursor-pointer px-6 py-2.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 font-medium shadow-sm flex items-center justify-center gap-2"
                                        disabled="@_procesando"
                                        type="submit">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    Guardar 
                                </button>
                            }
                        

                            </div>
                        </div>

                    </EditForm>
                </div>
            </div>
        }
        @if (MostrarModalArqueo)
        {
            <div class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
                <div class="w-full max-w-2xl max-h-[90vh] bg-white rounded-xl shadow-xl flex flex-col overflow-hidden">

                    <EditForm Model="_checkout" OnValidSubmit="RegistrarVenta" class="flex flex-col min-h-0">
                        <DataAnnotationsValidator />

                        <!-- Header -->
                        <div class="shrink-0 px-5 py-4 sm:px-6 border-b border-gray-200">
                            <h3 class="text-xl sm:text-2xl font-bold text-gray-800 text-center">
                                ARQUEO DE CAJA
                            </h3>
                        </div>

                        <!-- Productos -->
                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <div class="px-3 py-4 sm:px-6">
                                <div class="w-full rounded-lg border border-gray-200 overflow-hidden">
                                    <table class="w-full table-fixed border-collapse">

                                        <colgroup>
                                            <col class="w-[55%]" />
                                            <col class="w-[20%]" />
                                            <col class="w-[25%]" />
                                        </colgroup>

                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-3 sm:px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                                    Venta (ID)
                                                </th>
                                                <th class="px-2 sm:px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                                    Metodo Pago
                                                </th>
                                                <th class="px-2 sm:px-3 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                                    Monto
                                                </th>
                                            </tr>
                                        </thead>

                                        <tbody class="divide-y divide-gray-200 bg-white">
                                            @foreach (var item in VentasDelDia)
                                            {
                                                <tr>
                                                    <td class="px-3 sm:px-4 py-3 align-middle">
                                                        <div class="text-sm font-medium text-gray-900 wrap-break-word leading-5">
                                                            @($"{item.Id}")
                                                        </div>
                                                    </td>

                                                    <td class="px-2 sm:px-3 py-3 text-center align-middle text-sm font-medium text-gray-900 whitespace-nowrap">
                                                        @($"{item.MetodoPago}")
                                                    </td>
                                                    <td class="px-2 sm:px-3 py-3 text-center align-middle text-sm font-medium text-gray-900">
                                                        @($"{item.Total:N1} Bs")
                                                    </td>

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Resumen -->
                        <div class="shrink-0 px-4 py-4 sm:px-6 border-t border-gray-200 bg-gray-50">
                            <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-200">
                                <span>Subtotal:</span>

                                <span class="text-base sm:text-lg font-bold text-gray-400 whitespace-nowrap">
                                    @($"{TotalVentas} Bs.")
                                </span>
                            </div>

                            <div class="mt-3 pt-3 border-t border-gray-200 flex items-center justify-between gap-3">
                                <span class="text-base font-medium text-gray-900">
                                    Total QR:
                                </span>

                                <span class="text-base sm:text-lg font-bold text-gray-800 whitespace-nowrap">
                                    @($"{TotalQR} Bs.")
                                </span>
                            </div>
                            <div class="mt-3 pt-3 border-t border-gray-200 flex items-center justify-between gap-3">
                                <span class="text-base font-medium text-gray-900">
                                    Total Efectivo:
                                </span>

                                <span class="text-base sm:text-lg font-bold text-gray-800 whitespace-nowrap">
                                    @($"{TotalEfectivo} Bs.")
                                </span>
                            </div>

                        </div>

                        <!-- Botones -->
                        <div class="shrink-0 px-4 py-4 sm:px-6 border-t border-gray-200 bg-white">
                            <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 sm:justify-center">

                                <button type="button"
                                        @onclick="() => MostrarModalArqueo = false"
                                        class="w-full cursor-pointer sm:w-auto min-h-11 px-5 py-2.5 rounded-lg bg-gray-100 text-gray-700 font-medium inline-flex items-center justify-center gap-2 transition hover:bg-gray-200 active:scale-[0.98]">

                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>

                                    <span>Cerrar</span>
                                </button>
                            </div>
                        </div>

                    </EditForm>
                </div>
            </div>
        }

        <!-- Cuerpo: dos columnas con scroll -->

        <div class="flex flex-col h-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 h-full">
        
        <!-- Columna izquierda: Categorías -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col overflow-hidden h-80 sm:h-[calc(100vh-150px)]">
            <div class="bg-gray-800 px-4 py-2 font-medium border-b flex-none">
                <h1 class="text-md text-center lg:text-xl font-bold text-white">Productos</h1>
            </div>
            
            <!-- Grid de categorías responsivo y scrolleable -->
            <div class="flex-1 overflow-y-auto min-h-0 p-1">
                <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-1 xl:grid-cols-1 gap-1 auto-rows-min">
                    @foreach (var producto in _productosFiltrados.OrderBy(p => p.Nombre))
                    {
                        <button

                            @onclick="() => AgregarAlCarrito(producto)"
                            class="flex justify-between items-center  w-full py-3 px-2 cursor-pointer 
                            border border-gray-300 text-gray-800 
                            transition-colors duration-150 focus:outline-none rounded-lg">
                            <h3 class="w-full text-md px-2">@($"{producto.Subcategoria} {producto.Nombre} - {producto.Presentacion + producto.Unidad}")</h3>
                            <div class="flex justify-between w-14 px-2">
                                <h3>@($"{producto.PrecioVenta}")</h3>
                                <h3>@($" Bs.")</h3>
                            </div>
                        </button>
                    }
                    @if (!_productosFiltrados.Any())
                    {
                        <div class="col-span-full px-4 py-8 text-center text-gray-400">No hay categorías</div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna derecha: Venta Actual -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col h-80 sm:h-[calc(100vh-150px)]">
                    <div class="bg-gray-800 px-4 py-2 font-medium border-b flex-none">
                        <h1 class="text-md text-center lg:text-xl font-bold text-white">Venta Actual</h1>
                    </div>
                    <div class="flex-1 overflow-auto min-h-0">
                        <table class="min-w-full table-fixed w-full h-full">
                            <colgroup>
                                <col class="w-2/6">
                                <col class="w-2/6">
                                <col class="w-2/6">
                                <col class="w-2/6">
                            </colgroup>
                            <thead class="bg-gray-50 sticky top-0 z-10">
                                <tr>
                                    <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
                                    <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Cantidad</th>
                                    <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Subtotal</th>
                                    <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acción</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-300">
                                @foreach (var item in _carrito)
                                {
                                    <tr class="align-top">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium text-gray-900 truncate max-w-50">
                                                    @($"{item.Subcategoria} {item.Nombre}")
                                                </span>
                                            </div>
                                        </td>
                                        @* cantidad *@
                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                            <div class="flex items-center justify-center">
                                                <button @onclick="() => RestarCantidad(item)" class="px-2 mx-1 text-gray-800 rounded-full hover:bg-gray-700 hover:text-white transition-colors cursor-pointer text-lg">-</button>
                                                <span class="inline-flex items-center justify-center px-3 py-1 bg-gray-800 text-white text-sm font-medium rounded-full min-w-10">
                                                    @item.Cantidad
                                                </span>
                                                <button @onclick="() => SumarCantidad(item)" class="px-2 mx-1 text-gray-800 rounded-full hover:bg-gray-700 hover:text-white transition-colors cursor-pointer text-lg">+</button>
                                            </div>
                                        </td>
                                        @* subtotal *@
                                        <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">
                                            @($"{item.Cantidad * item.PrecioVenta} Bs.")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                            <button @onclick="() => EliminarProducto(item)"
                                                    class="group text-red-600 transition-colors duration-200 cursor-pointer
                                                    ease-in-out
                                                    hover:scale-120
                                                    active:scale-95">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 inline-block group-hover:-rotate-12 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M10 11v6"/>
                                                    <path d="M14 11v6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                                                    <path d="M3 6h18"/>
                                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!_carrito.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="px-6 py-8 text-center text-gray-500 h-max">
                                            No hay productos en el carrito.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-gray-50 sticky bottom-0 z-10">
                                <tr>
                                    <td colspan="1" class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">
                                        Total:
                                    </td>
                                    <td colspan="1"></td>
                                    <td colspan="1" class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">
                                        @($"{_carrito.Sum(x => x.Cantidad * x.PrecioVenta)} Bs.")
                                    </td>
                                    <td colspan="1"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
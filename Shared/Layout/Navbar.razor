@inherits LayoutComponentBase
<div class="flex flex-col lg:flex-row min-h-screen w-full">
    <!-- Sidebar Navigation - Mejorado para móvil -->
    <aside class="lg:w-64 xl:w-72 bg-gray-900 text-white shrink-0">
        <nav class="h-full flex flex-col p-4">
            <!-- Logo y título -->
            <header class="mb-6 lg:mb-8 text-center">
                <h1 class="font-bold text-xl lg:text-2xl flex items-center gap-2 justify-center">
                    <span>MADSI</span>
                </h1>
                <p class="text-gray-400 text-sm mt-1">Sistema de Gestión</p>
            </header>
            <!-- Menú de navegación -->
            <ul class="space-y-2 flex-1">
                <li>
                    <NavLink href="" 
                        class="w-full text-left p-3 rounded-lg hover:bg-blue-950 transition-all duration-200 flex items-center gap-3 
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-gray-900"
                        aria-current="page">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-3.75ZM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-8.25ZM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-2.25Z" />
                        </svg>

                        <span>Dashboard</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="inventario"
                        class="w-full visited:text-gray-300 text-left p-3 rounded-lg hover:bg-gray-800 transition-colors duration-200 
                        flex items-center gap-3 focus:outline-none focus:ring-2 focus:ring-gray-700 
                        focus:ring-offset-2 focus:ring-offset-gray-900">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m7.875 14.25 1.214 1.942a2.25 2.25 0 0 0 1.908 1.058h2.006c.776 0 1.497-.4 1.908-1.058l1.214-1.942M2.41 9h4.636a2.25 2.25 0 0 1 1.872 1.002l.164.246a2.25 2.25 0 0 0 1.872 1.002h2.092a2.25 2.25 0 0 0 1.872-1.002l.164-.246A2.25 2.25 0 0 1 16.954 9h4.636M2.41 9a2.25 2.25 0 0 0-.16.832V12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 12V9.832c0-.287-.055-.57-.16-.832M2.41 9a2.25 2.25 0 0 1 .382-.632l3.285-3.832a2.25 2.25 0 0 1 1.708-.786h8.43c.657 0 1.281.287 1.709.786l3.284 3.832c.163.19.291.404.382.632M4.5 20.25h15A2.25 2.25 0 0 0 21.75 18v-2.625c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125V18a2.25 2.25 0 0 0 2.25 2.25Z" />
                        </svg>
                        <span>Inventario</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="caja"
                        class="w-full visited:text-gray-300 text-left p-3 rounded-lg hover:bg-gray-800 transition-colors duration-200 
                        flex items-center gap-3 focus:outline-none focus:ring-2 focus:ring-gray-700 
                        focus:ring-offset-2 focus:ring-offset-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
                    </svg>
                        <span>Caja</span>
                    </NavLink>
                </li>
            </ul>

            <!-- Perfil de usuario -->
            <footer class="pt-4 mt-6 border-t border-gray-700">
                <button class="w-full flex items-center gap-3 p-2 hover:bg-gray-800 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-700">
                    <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center shrink-0">
                        <span class="font-bold">A</span>
                    </div>
                    <div class="flex-1 min-w-0 text-left">
                        <span class="block font-medium truncate">Admin</span>
                        <span class="text-xs text-gray-400 truncate">administrador@empresa.com</span>
                    </div>
                    <span class="text-gray-400 shrink-0" aria-hidden="true">▼</span>
                </button>
            </footer>
        </nav>
    </aside>
    <!-- Contenido principal -->
    <main class="flex-1 w-full overflow-auto">
        <article class="h-full w-full">
            @Body
        </article>
    </main>
</div>
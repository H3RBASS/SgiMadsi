@page "/test"

@using SgiMadsi.Shared.Domain
@inject Supabase.Client Client

<h3>Prueba de conexión a Supabase</h3>

<button @onclick="ProbarConexion">
    Probar conexión
</button>

<p>@mensaje</p>

@code {

    private string mensaje = "Sin probar";

    private async Task ProbarConexion()
    {
        try
        {
            var response = await Client
                .From<ProductoP>()
                .Get();

            mensaje = $"Conectado correctamente. Productos encontrados: {response.Models}";
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
        }
    }

}
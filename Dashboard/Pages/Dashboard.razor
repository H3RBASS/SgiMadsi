            <article class="bg-white rounded-xl shadow-lg p-4 lg:p-6 xl:col-span-1">
                <div class="flex justify-between items-start mb-4">
                    <div class="min-w-0">
                        <p class="text-gray-500 text-sm truncate">Agotados</p>
                        <h2 class="text-2xl lg:text-3xl font-bold text-gray-800 mt-2 truncate">@ProductosFueraStock.Count()</h2>
                    </div>
                    <div class="bg-orange-100 p-3 rounded-full shrink-0 ml-2">
                        <span class="text-xl lg:text-2xl text-orange-600" aria-hidden="true">🛑</span>
                    </div>
                </div>

                <!-- Lista de productos agotados -->
                <div class="flex-1 overflow-y-auto max-h-72">
                    <table class="w-full table-auto">
                        <thead class="sticky top-0 bg-white z-10 shadow-sm">
                            <tr class="border-b border-gray-200">
                                <th class="text-left py-3 text-gray-500 font-medium text-sm w-1/3">Producto</th>
                                <th class="text-left py-3 text-gray-500 font-medium text-sm w-1/5">Stock</th>
                                <th class="text-left py-3 text-gray-500 font-medium text-sm w-1/6">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ProductosFueraStock != null && ProductosFueraStock.Any())
                            {
                                @foreach (var producto in ProductosFueraStock)
                                {
                                    <tr class="border-b border-gray-50 hover:bg-gray-50 transition-colors duration-150">
                                        <td class="py-3">
                                            <div class="flex items-center min-w-0">
                                                <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3 shrink-0">
                                                    <span class="text-blue-600 text-xs font-bold">P</span>
                                                </div>
                                                <span class="truncate">@producto.Nombre</span>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <div class="flex items-center">
                                                <div class="w-4 bg-gray-200 rounded-full h-2 mr-2">
                                                    @{
                                                        var porcentaje = Math.Min(producto.Stock, 100);
                                                        var color = producto.Stock > 10 ? "bg-green-500" :
                                                                    (producto.Stock >= 5 ? "bg-yellow-500" : "bg-red-500");
                                                    }
                                                    <div class="@color h-2 rounded-full" style="width: 100%; max-width: 100%"></div>
                                                </div>
                                                <span class="text-sm whitespace-nowrap">@producto.Stock</span>
                                            </div>
                                        </td>

                                        @*VENTAS <td class="py-3 font-bold text-sm">148</td>*@

                                        <td class="py-3">
                                            @if (producto.Stock > 10)
                                            {
                                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full whitespace-nowrap">Óptimo</span>
                                            }
                                            else if (producto.Stock >= 5)
                                            {
                                                <span class="bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full whitespace-nowrap">Bajo</span>
                                            }
                                            else
                                            {
                                                <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full whitespace-nowrap">Crítico</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-gray-500">
                                        No hay productos disponibles.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
            <!-- Sale of Day -->
            <article class="bg-white rounded-xl shadow-lg p-4 lg:p-6 xl:col-span-1">
                <div class="flex justify-between items-start mb-4">
                    <div class="min-w-0">

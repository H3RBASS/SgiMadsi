                            {
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-gray-500">
                                        No hay ventas disponibles.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>

            
        </section>
    </main>
</div>

@page "/dashboard"
@layout Navbar
@namespace SgiMadsi.Dashboard.Pages
@using System.Reflection.Emit

<PageTitle>Dashboard</PageTitle>

<div class="min-h-screen w-full bg-gray-50 text-gray-800">
    <!-- Contenido principal -->
    <main class="flex-1 p-4 lg:p-6">
        <!-- Header -->
        <header class="bg-white rounded-xl shadow-sm p-4 lg:p-6 mb-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="">
                    <h1 class="text-xl text-center sm:text-left lg:text-2xl font-bold text-gray-800">Dashboard de Inventario</h1>
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                    <button @onclick="AbrirModal" 
                            class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 
                                   focus:outline-none cursor-pointer transition duration-200 hover:scale-105">
                        + Nuevo Producto
                    </button>
                    <button @onclick="AbrirVentanaProveedor" 
                            class="bg-gray-900 text-white px-4 py-2 rounded-lg  
                                   focus:outline-none cursor-pointer transition duration-200 hover:scale-105">
                        + Nuevo Proveedor
                    </button>
                </div>
            </div>
            <span></span>

        </header>
 
        <!-- Modal -->
        @if (MostrarModal)
    {
        <div class="fixed inset-0 bg-black/50 backdrop-blur-md flex items-center justify-center z-50 p-4">
            <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 md:p-8 transition-all duration-300 max-h-[90vh] overflow-y-auto">

                <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">Añadir producto</h3>

                    <EditForm Model="_nuevoProducto" OnValidSubmit="GuardarProducto">
                        <DataAnnotationsValidator />

                        <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                            <!-- Nombre (ocupa toda la fila) -->
                            <div class="col-span-2 flex flex-col gap-1">
                                <label for="nombre" class="text-sm font-medium text-gray-700">Nombre del producto</label>
                                <InputText @bind-Value="_nuevoProducto.Nombre"
                                        id="nombre"
                                        placeholder="Ej: Nacional Clasico Doble Hoja"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <ValidationMessage For="() => _nuevoProducto.Nombre" class="text-sm text-red-600" />
                            </div>

                            <!-- Precio Venta -->
                            <div class="flex flex-col gap-1">
                                <label for="precioVenta" class="text-sm font-medium text-gray-700">Precio Venta (Bs)</label>
                                <InputNumber @bind-Value="_nuevoProducto.PrecioVenta"
                                            id="precioVenta"
                                            min="0"
                                            step="0.01"
                                            placeholder="0.00"
                                            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <ValidationMessage For="() => _nuevoProducto.PrecioVenta" class="text-sm text-red-600" />
                            </div>

                            <!-- Precio Compra -->
                            <div class="flex flex-col gap-1">
                                <label for="precioCompra" class="text-sm font-medium text-gray-700">Precio Compra (Bs)</label>
                                <InputNumber @bind-Value="_nuevoProducto.PrecioCompra"
                                            id="precioCompra"
                                            min="0"
                                            step="0.01"
                                            placeholder="0.00"
                                            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <span class="text-xs text-gray-500 mt-0.5">(Opcional)</span>
                                <ValidationMessage For="() => _nuevoProducto.PrecioCompra" class="text-sm text-red-600" />
                            </div>

                            <!-- Presentación -->
                            <div class="flex flex-col gap-1">
                                <label for="presentacion" class="text-sm font-medium text-gray-700">Presentación</label>
                                <InputNumber @bind-Value="_nuevoProducto.Presentacion"
                                            id="presentacion"
                                            min="0"
                                            step="0.01"
                                            placeholder="Cantidad numérica"
                                            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <span class="text-xs text-gray-500 mt-0.5">Ej: 1, 500, 1000 (sin unidad)</span>
                                <ValidationMessage For="() => _nuevoProducto.Presentacion" class="text-sm text-red-600" />
                            </div>

                            <!-- Unidad -->
                            <div class="flex flex-col gap-1">
                                <label for="unidad" class="text-sm font-medium text-gray-700">Unidad</label>
                                <InputSelect @bind-Value="_nuevoProducto.Unidad"
                                            id="unidad"
                                            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out appearance-none bg-white">
                                    <option value="" disabled selected hidden>Seleccionar</option>
                                    <option value="kg">Kilogramos (kg)</option>
                                    <option value="g">Gramos (g)</option>
                                    <option value="L">Litros (L)</option>
                                    <option value="ml">Mililitros (ml)</option>
                                    <option value="uds">Unidades (uds)</option>
                                </InputSelect>
                                <ValidationMessage For="() => _nuevoProducto.Unidad" class="text-sm text-red-600" />
                            </div>


                            <!-- Categoría -->
                            <div class="flex flex-col gap-1">
                                <label for="categoria" class="text-sm font-medium text-gray-700">Categoría</label>
                                <InputSelect @bind-Value="_nuevoProducto.Categoria"
                                            id="categoria"
                                            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out appearance-none bg-white">
                                    <option value="" disabled selected hidden>Seleccione una categoría</option>
                                    <option value="Abarrotes">Abarrotes</option>
                                    <option value="Cocina">Cocina</option>
                                    <option value="Enlatados">Enlatados</option>
                                    <option value="Higiene Personal">Higiene Personal</option>
                                    <option value="Insumos y Otros">Insumos y Otros</option>
                                    <option value="Limpieza">Limpieza</option>
                                    <option value="Plasticos">Plásticos</option>
                                    <option value="Reposteria">Repostería</option>
                                </InputSelect>
                                <ValidationMessage For="() => _nuevoProducto.Categoria" class="text-sm text-red-600" />
                            </div>

                            <!-- Subcategoría -->
                            <div class="flex flex-col gap-1">
                                <label for="subcategoria" class="text-sm font-medium text-gray-700">Subcategoría</label>
                                <input id="subcategoria"
                                    list="subcategorias-list"
                                    @bind="_nuevoProducto.Subcategoria"
                                    @bind:event="oninput"
                                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out bg-white"
                                    placeholder="Escribe o selecciona..." />
                                <datalist id="subcategorias-list">
                                    @foreach (var subcategoria in _productos.Select(p => p.Subcategoria).Distinct().OrderBy(s => s))
                                    {
                                        <option value="@subcategoria" />
                                    }
                                </datalist>
                                <ValidationMessage For="() => _nuevoProducto.Subcategoria" class="text-sm text-red-600" />
                            </div>

                            <!-- Stock (opcional) -->
                             <div class="flex flex-col gap-1">
                                <label for="stock" class="text-sm font-medium text-gray-700">
                                    Stock <span class="text-gray-400 font-normal"></span>
                                </label>
                                <InputNumber @bind-Value="_nuevoProducto.Stock"
                                            id="stock"
                                            min="0"
                                            step="1"
                                            inputmode="numeric"
                                            placeholder="Cantidad en existencia"
                                            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <span class="text-xs text-gray-500 mt-0.5">(Opcional)</span>
                                <ValidationMessage For="() => _nuevoProducto.Stock" class="text-sm text-red-600" />
                            </div>
                        </div>
                            @* Aqui oculta/muestra el mensaje, si se guardo o no el producto en la BD *@
                            @if(_mensajeConfirmacion)
                                {
                                    <h1 class="w-full mt-6 bg-green-100 text-green-400 text-center rounded-md py-2">"Datos guardados correctamente"</h1>
                                } 
                        <!-- Botones -->
                        <div class="flex flex-col-reverse sm:flex-row justify-center items-center gap-3 mt-6 pt-6 border-t border-gray-200">
                            <!-- Botón Cancelar -->
                            <button class="w-full sm:w-auto cursor-pointer px-6 py-2.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 hover:shadow-md hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition-all duration-200 font-medium flex items-center justify-center gap-2"
                                    type="button"
                                    @onclick="CerrarModal">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                Cancelar
                            </button>
                            @* Condicional para el estado de Boton Guardar *@
                            @if(_procesando)
                            {
                                <button
                                    disabled
                                    class="flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-white disabled:cursor-not-allowed disabled:opacity-70">

                                    <svg
                                        class="h-5 w-5 animate-spin"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24">

                                        <circle
                                            class="opacity-25"
                                            cx="12"
                                            cy="12"
                                            r="10"
                                            stroke="currentColor"
                                            stroke-width="4"/>

                                        <path
                                            class="opacity-75"
                                            fill="currentColor"
                                            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
                                    </svg>

                                    Guardando...
                                </button>
                            }
                            else
                            {
                                <!-- Botón Guardar -->
                                <button class="w-full sm:w-auto cursor-pointer px-6 py-2.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 font-medium shadow-sm flex items-center justify-center gap-2"
                                        disabled="@_procesando"
                                        type="submit">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    Guardar 
                                </button>
                            }
                        
                        </div>
                    </EditForm>
            </div>
        </div>

    } 
        @if (MostrarVentanaProveedor)
        {
            <div class="fixed inset-0 bg-black/50 backdrop-blur-md flex items-center justify-center z-50 p-4">
                <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-6">

                    <h3 class="text-xl font-semibold mb-4 text-center">Añadir proveedor</h3>

                    <EditForm Model="_nuevoProveedor" OnValidSubmit="GuardarProveedor" class="flex flex-col gap-4">
                        <DataAnnotationsValidator />

                        
                        <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                            <!-- Nombre (ocupa toda la fila) -->
                            <div class="col-span-2 flex flex-col gap-1">
                                <label for="nombre" class="text-sm font-medium text-gray-700">Nombre del Proveedor</label>
                                <InputText @bind-Value="_nuevoProveedor.Proveedor"
                                        id="nombre"
                                        placeholder="ej: Proveedor S.A"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <ValidationMessage For="() => _nuevoProveedor.Proveedor" class="text-sm text-red-600" />
                            </div>

                            <div class="col-span-2 flex flex-col gap-1">
                                <label for="detalle" class="text-sm font-medium text-gray-700">Detalle:</label>
                                <InputText @bind-Value="_nuevoProveedor.Detalle"
                                        id="detalle"
                                        placeholder="ej: Proveedor de productos de Ferdy"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150 ease-in-out" />
                                <ValidationMessage For="() => _nuevoProveedor.Detalle" class="text-sm text-red-600" />
                            </div>

                            <div class="col-span-2 flex flex-col gap-x-6 gap-y-2">
                                @if (_archivoSeleccionado != null)
                                {
                                    <label class="text-sm font-medium text-gray-700">Imagen seleccionada:</label>
                                    <div class="flex items-center gap-2 bg-gray-100 p-2 rounded-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" 
                                            width="28" 
                                            height="28" 
                                            viewBox="0 0 24 24" 
                                            fill="none" 
                                            stroke="currentColor" 
                                            stroke-width="2" 
                                            stroke-linecap="round" 
                                            stroke-linejoin="round" 
                                            class="lucide lucide-file-image-icon lucide-file-image">
                                            <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/>
                                            <path d="M14 2v5a1 1 0 0 0 1 1h5"/>
                                            <circle cx="10" cy="12" r="2"/>
                                            <path d="m20 17-1.296-1.296a2.41 2.41 0 0 0-3.408 0L9 22"/>
                                        </svg>
                                        <label class="flex-1 truncate text-sm font-medium text-gray-700">
                                            @_archivoSeleccionado.Name
                                        </label>
                                        <button type="button" @onclick="EliminarArchivo" class="px-4 py-2 cursor-pointer bg-gray-600 text-white rounded-lg hover:bg-red-500 transition">
                                            <svg xmlns="http://www.w3.org/2000/svg" 
                                                width="24" 
                                                height="24" 
                                                viewBox="0 0 24 24" 
                                                fill="none" 
                                                stroke="currentColor" 
                                                stroke-width="2" 
                                                stroke-linecap="round" 
                                                stroke-linejoin="round" 
                                                class="lucide lucide-trash2-icon lucide-trash-2">
                                                <path d="M10 11v6"/>
                                                <path d="M14 11v6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                                                <path d="M3 6h18"/>
                                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                }
                                <label class="text-sm font-medium text-gray-700">
                                    Imagen:
                                </label>

                                <label for="archivo"
                                    class="flex flex-col items-center justify-center border border-gray-300 rounded-lg px-4 py-4 cursor-pointer hover:bg-gray-100 transition">


                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        width="32"
                                        height="32"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="mt-2">
                                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                                        <circle cx="9" cy="9" r="2"/>
                                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                                    </svg>
                                    <span class="text-sm font-medium text-gray-700">
                                        Seleccionar imagen
                                    </span>
                                </label>


                                <InputFile id="archivo"
                                        OnChange="SeleccionarImagen"
                                        accept="image/*"
                                        class="hidden" />

                                <ValidationMessage For="() => _nuevoProveedor.Imagen"
                                                class="text-sm text-red-600" />
                            </div>

                        </div>

                        @* Aqui oculta/muestra el mensaje, si se guardo o no el producto en la BD *@
                        @if(_mensajeConfirmacionProveedores)
                            {
                                <h1 class="w-full mt-6 bg-green-100 text-green-400 text-center rounded-md py-2">"Datos guardados correctamente"</h1>
                            } 

                        <!-- Botones -->
                        <div class="flex flex-col-reverse sm:flex-row justify-center items-center gap-3 mt-6 pt-6 border-t border-gray-200">
                            <!-- Botón Cancelar -->
                            <button class="w-full sm:w-auto cursor-pointer px-6 py-2.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 hover:shadow-md hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition-all duration-200 font-medium flex items-center justify-center gap-2"
                                    type="button"
                                    @onclick="CerrarVentanaProveedor">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                Cancelar
                            </button>
                            @if(_procesandoProveedor)
                            {
                                <button
                                    disabled
                                    class="flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-white disabled:cursor-not-allowed disabled:opacity-70">

                                    <svg
                                        class="h-5 w-5 animate-spin"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24">

                                        <circle
                                            class="opacity-25"
                                            cx="12"
                                            cy="12"
                                            r="10"
                                            stroke="currentColor"
                                            stroke-width="4"/>

                                        <path
                                            class="opacity-75"
                                            fill="currentColor"
                                            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
                                    </svg>

                                    Guardando...
                                </button>
                            }
                            else
                            {
                                <button class="w-full sm:w-auto cursor-pointer px-6 py-2.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 font-medium shadow-sm flex items-center justify-center gap-2"
                                        disabled="@_procesandoProveedor"
                                        type="submit">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    Guardar 
                                </button>
                            }

                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <!-- Grid de tarjetas KPI -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-4 lg:gap-6 mb-6">
            <!-- Total Stock Value -->
            <article class="bg-linear-to-br from-blue-500 to-blue-600 text-white rounded-xl shadow-lg p-4 lg:p-6">
                <div class="flex justify-between items-start">
                    <div class="min-w-0">
                        <p class="text-blue-100 text-sm truncate">Valor Total</p>
                        <h2 class="text-2xl lg:text-3xl font-bold mt-2 truncate">@_productos.Sum(p => p.PrecioVenta * p.Stock).ToString("N0") Bs</h2>
                        <p class="text-blue-100 text-sm mt-2">+12.5% vs mes anterior</p>
                    </div>
                    <div class="bg-white/20 p-3 rounded-full shrink-0 ml-2">
                        <span class="text-xl lg:text-2xl" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
                            </svg>
                        </span>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-white/20">
                    <p class="text-sm truncate">Valor promedio del Inventario: Bs @_productos.Sum(p => p.PrecioVenta)</p>
                </div>
            </article>

            <!-- Total Items -->
            <article class="bg-white rounded-xl shadow-lg p-4 lg:p-6">
                <div class="flex justify-between items-start">
                    <div class="min-w-0">
                        <p class="text-gray-500 text-sm truncate">Productos Totales</p>
                        <h2 class="text-2xl lg:text-3xl font-bold text-gray-800 mt-2 truncate">@_productos.Count()</h2>
                        <p class="text-green-600 text-sm font-medium mt-2">+45 productos este mes</p>
                    </div>
                    <div class="bg-green-100 p-3 rounded-full shrink-0 ml-2">
                        <span class="text-xl lg:text-2xl text-green-600" aria-hidden="true">📦</span>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100">
                    <div class="flex items-center">
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-green-500 h-2 rounded-full" style="width: 78%"></div>
                        </div>
                        <span class="text-sm text-gray-500 ml-2 whitespace-nowrap">78% stock óptimo</span>
                    </div>
                </div>
            </article>

            <!-- Low Stock Alert -->
            <article class="bg-white rounded-xl shadow-lg p-4 lg:p-6">
                <div class="flex justify-between items-start">
                    <div class="min-w-0">
                        <p class="text-gray-500 text-sm truncate">Stock Bajo</p>
                        <h2 class="text-2xl lg:text-3xl font-bold text-gray-800 mt-2 truncate"> @ProductosBajoStock.Count()</h2>
                        <p class="text-red-600 text-sm font-medium mt-2">Necesita reabastecimiento</p>
                    </div>
                    <div class="bg-red-100 p-3 rounded-full shrink-0 ml-2">
                        <span class="text-xl lg:text-2xl text-red-600" aria-hidden="true">⚠️</span>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex flex-wrap items-center text-sm gap-1">
                        <span class="text-gray-500">Producto crítico:</span>
                        <span class="font-medium truncate">@ProductosBajoStock.FirstOrDefault()?.Nombre</span>
                        <span class="ml-auto text-red-600 font-bold whitespace-nowrap">@ProductosBajoStock.FirstOrDefault()?.Stock unidades</span>
                    </div>
                </div>
            </article>
        </section>

